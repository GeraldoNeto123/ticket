{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/referencias-de-linha.py",
            "timeout": 10,
            "statusMessage": "Conferindo referências de linha no documento..."
          }
        ]
      }
    ]
  }
}
