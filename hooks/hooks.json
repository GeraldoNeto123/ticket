{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/runbook-checkpoint.py",
            "if": "Bash(git commit *)",
            "timeout": 20,
            "statusMessage": "Conferindo o checkpoint do runbook..."
          }
        ]
      }
    ]
  }
}
